# Copy this file to `.env` and adjust values for your machine. `.env` is git-ignored and must
# never be committed. See TECH-PLAN.md §3.6 for the full reasoning behind this setup.
#
# These are non-secret (host/port only) — the reference server has no authentication. Do NOT
# put real secrets/API keys behind the EXPO_PUBLIC_ prefix: it gets inlined into the JS bundle
# at build time and is readable by anyone with the app binary.

# Host of the reference server (holdedlab/frontend-challenge running `go run server.go`).
#   - iOS Simulator:      localhost
#   - Android Emulator:   10.0.2.2
#   - Physical device:    LAN IP of the machine running the server (e.g. 192.168.1.23)
EXPO_PUBLIC_API_HOST=localhost

# Port the server is listening on (matches the server's default).
EXPO_PUBLIC_API_PORT=8080
